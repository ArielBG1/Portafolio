---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));

const links = [
  { href: profile.linkedin, icon: 'lucide:linkedin', label: t('social.linkedin'), external: true },
  { href: profile.github, icon: 'lucide:github', label: t('social.github'), external: true },
  { href: `mailto:${profile.email}`, icon: 'lucide:mail', label: t('social.email'), external: false },
] as const;
---

<ul class:list={['flex items-center gap-1', className]} aria-label={t('social.label')}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="icon-btn"
          aria-label={link.external ? `${link.label} ${t('a11y.newTab')}` : link.label}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <Icon name={link.icon} class="size-5" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>
