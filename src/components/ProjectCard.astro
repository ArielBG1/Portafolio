---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import JsonLines from './JsonLines.astro';
import RichText from './RichText.astro';
import TechIcon from './TechIcon.astro';
import type { ProjectData } from '../lib/projects';
import { jsonToLines, type JsonValue } from '../lib/json-tokens';
import { getLang, getSectionId, useTranslations } from '../i18n/utils';

interface Props {
  project: ProjectData;
  /** id del archivo (ej.: `cyclo`), usado como ruta del recurso. */
  slug: string;
  /** Versión ancha (ocupa todo el ancho arriba de la grilla). */
  featured?: boolean;
}

const { project, slug, featured = false } = Astro.props;
const { title, description, icon, accent = '#7C6CF2', stack, repo, demo, image, team, role } = project;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const externalSuffix = `: ${title} ${t('a11y.newTab')}`;
const resourcePath = `/${getSectionId(lang, 'projects')}/${slug}`;

// Vista previa del recurso en JSON, armada con los datos reales del proyecto.
const stripProtocol = (url: string) => url.replace(/^https?:\/\//, '');
const preview: Record<string, JsonValue> = { id: slug };
if (role) preview[t('json.role')] = role;
preview.stack = stack.map((tech) => tech.name);
preview.repo = stripProtocol(repo);
if (demo) preview.demo = stripProtocol(demo);
const previewLines = jsonToLines(preview);
---

<article
  class:list={['card card-hover group flex h-full flex-col overflow-hidden', featured && 'lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]']}
  style={`--project-accent: ${accent}`}
>
  <div class="console flex flex-col rounded-none border-0 shadow-none" aria-hidden="true">
    <div class="console-bar rounded-none text-xs">
      <span class="method" style="color: var(--c-get)">GET</span>
      <span class="min-w-0 truncate text-(--c-muted)">{resourcePath}</span>
      <span class="ml-auto text-(--c-ok)">200</span>
    </div>
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={[480, 800, 1200]}
          sizes={featured ? '(min-width: 1024px) 560px, 100vw' : '(min-width: 768px) 560px, 100vw'}
          class={featured ? 'aspect-video size-full object-cover lg:aspect-auto' : 'h-44 w-full object-cover'}
        />
      ) : (
        <div class:list={['project-code relative flex-1 overflow-hidden p-4 text-[12px] leading-relaxed sm:p-5', !featured && 'h-44']}>
          <code class="block" data-parallax>
            <JsonLines lines={previewLines} />
          </code>
          <span
            class:list={[
              'absolute top-4 right-4 flex items-center justify-center rounded-xl border border-(--c-border) bg-(--c-bar) shadow-lg transition-transform duration-300 motion-safe:group-hover:scale-105 sm:top-5 sm:right-5',
              featured ? 'size-16' : 'size-12',
            ]}
          >
            <Icon name={`lucide:${icon}`} class:list={['text-(--project-accent)', featured ? 'size-8' : 'size-6']} />
          </span>
        </div>
      )
    }
  </div>

  <div class:list={['flex flex-1 flex-col p-6', featured && 'sm:p-8']}>
    {
      (featured || team || role) && (
        <div class="mb-3 flex flex-wrap items-center gap-2">
          {featured && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs font-semibold text-brand">
              <Icon name="lucide:star" class="size-3.5" aria-hidden="true" />
              {t('projects.featured')}
            </span>
          )}
          {role && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-post/40 bg-post/10 px-2.5 py-1 text-xs font-semibold text-post">
              <Icon name="lucide:user-round-cog" class="size-3.5" aria-hidden="true" />
              <span class="sr-only">{`${t('projects.role')}: `}</span>
              {role}
            </span>
          )}
          {team && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs font-medium text-muted">
              <Icon name="lucide:users" class="size-3.5" aria-hidden="true" />
              {team}
            </span>
          )}
        </div>
      )
    }

    <h3 class:list={['font-semibold tracking-tight', featured ? 'text-2xl' : 'text-xl']}>{title}</h3>
    <p class="mt-3 leading-relaxed text-pretty text-muted">
      <RichText text={description} />
    </p>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label={t('projects.stack')}>
      {
        stack.map((tech) => (
          <li class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-2 py-1 pr-2.5 pl-1 text-xs font-medium text-muted">
            <TechIcon icon={tech.icon} class="size-6" />
            {tech.name}
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap gap-3 pt-6">
      {
        demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <Icon name="lucide:external-link" class="size-4" aria-hidden="true" />
            {t('projects.demo')}
            <span class="sr-only">{externalSuffix}</span>
          </a>
        )
      }
      <a href={repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        <Icon name="lucide:github" class="size-4" aria-hidden="true" />
        {t('projects.repo')}
        <span class="sr-only">{externalSuffix}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .project-code {
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
</style>
